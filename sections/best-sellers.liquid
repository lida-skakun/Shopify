<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<section class="best-sellers">
  <h2 class="best-sellers-header">BEST SELLERS</h2>
  <ul class="best-sellers-list" hidden md:flex>
    {% for i in (1..4) %}
      {% assign product_setting = 'best_seller_' | append: i %}
      {% assign product_handle = section.settings[product_setting] %}

      {% if product_handle != blank %}
        {% assign product = all_products[product_handle] %}
      {% else %}
        {% assign product = null %}
      {% endif %}

      {% render 'best-sellers-product', product: product %}
    {% endfor %}
  </ul>
  <div class="md:hidden">
    <div class="swiper">
      <div class="swiper-wrapper">
        {% for i in (1..4) %}
          {% assign product_setting = 'best_seller_' | append: i %}
          {% assign product_handle = section.settings[product_setting] %}

          {% if product_handle != blank %}
            {% assign product = all_products[product_handle] %}
          {% else %}
            {% assign product = null %}
          {% endif %}

          <div class="swiper-slide">
            {% render 'best-sellers-product', product: product %}
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>

  <h4 class="collection-link">
    <a href="/">View Collection </a>
  </h4>
</section>

<script>
  window.addEventListener('load', function () {
    const swiper = new Swiper('.swiper', {
      direction: 'horizontal',
      loop: true,

      pagination: {
        el: '.swiper-pagination',
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>

{% schema %}
{
  "name": "Best Sellers",
  "settings": [
    {
      "type": "product",
      "id": "best_seller_1",
      "label": "Best seller 1"
    },
    {
      "type": "product",
      "id": "best_seller_2",
      "label": "Best seller 2"
    },
    {
      "type": "product",
      "id": "best_seller_3",
      "label": "Best seller 3"
    },
    {
      "type": "product",
      "id": "best_seller_4",
      "label": "Best seller 4"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}
